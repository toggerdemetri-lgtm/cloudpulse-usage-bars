<Window x:Class="UsageIsland.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="云脉·用量颜色条 · 设置" Icon="pack://application:,,,/Assets/App.ico" Width="570" Height="720" MinWidth="520" MinHeight="560" WindowStartupLocation="CenterScreen" Background="#10151E" Foreground="#E9EDF5" FontFamily="Microsoft YaHei UI" FontSize="12">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#202735"/><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="BorderBrush" Value="#3B4659"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#202735"/><Setter Property="Foreground" Value="#F1F4FA"/><Setter Property="BorderBrush" Value="#3B4659"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,0,8"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Background" Value="#DFE6F1"/><Setter Property="Foreground" Value="#18202D"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#B7C1D3"/><Setter Property="Margin" Value="0,3,0,12"/></Style>
  </Window.Resources>
  <DockPanel Margin="26,22">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="云脉·用量颜色条" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="四根短条，随时看见服务器的状态。" Foreground="#93A0B7" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Foreground="#AFBCD0" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="设置仅保存在这台电脑" Foreground="#74829B" VerticalAlignment="Center"/>
        <Button x:Name="TestButton" Content="测试连接" Grid.Column="1" Click="Test_Click"/>
        <Button x:Name="SaveButton" Content="保存并应用" Grid.Column="2" Background="#6DE3B0" Click="Save_Click" IsDefault="True"/>
      </Grid>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="实例连接" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="云厂商"/>
        <ComboBox x:Name="VendorBox" DisplayMemberPath="Name" SelectedValuePath="Vendor" SelectionChanged="Vendor_Changed" Padding="9,7" Margin="0,5,0,12" Foreground="#18202D" AutomationProperties.Name="云厂商"/>
        <TextBlock x:Name="InstanceLabel" Text="实例 ID"/><TextBox x:Name="InstanceBox" AutomationProperties.Name="实例 ID"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="地域 ID"/><TextBox x:Name="RegionBox" AutomationProperties.Name="地域 ID"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock x:Name="BandwidthLabel" Text="出站带宽（Mbps）"/><TextBox x:Name="BandwidthBox" AutomationProperties.Name="出站带宽 Mbps"/></StackPanel>
        </Grid>
        <TextBlock x:Name="CloudHint" Foreground="#93A0B7" Margin="0,-3,0,16" TextWrapping="Wrap"/>
        <StackPanel x:Name="ProjectPanel" Visibility="Collapsed"><TextBlock Text="地域对应项目 ID（不是账号 ID）"/><TextBox x:Name="ProjectBox" AutomationProperties.Name="华为云项目 ID"/></StackPanel>
        <CheckBox x:Name="AwsDetailedBox" Visibility="Collapsed" Content="该 EC2 已开启详细监控（1分钟）"/>
        <TextBlock x:Name="AccessKeyLabel" Text="密钥 ID"/><TextBox x:Name="AccessKeyBox" AutomationProperties.Name="密钥 ID"/>
        <TextBlock x:Name="SecretLabel" Text="密钥 Secret"/><PasswordBox x:Name="SecretBox" AutomationProperties.Name="密钥 Secret"/>
        <TextBlock x:Name="SecretHint" Foreground="#93A0B7" Margin="0,0,0,10" TextWrapping="Wrap"/>
        <StackPanel x:Name="TokenPanel" Visibility="Collapsed"><TextBlock Text="临时凭证 Token（可选；不使用临时凭证则留空）"/><PasswordBox x:Name="TokenBox" AutomationProperties.Name="临时凭证 Token"/></StackPanel>
        <CheckBox x:Name="ClearCredentialsBox" Content="清除当前厂商已保存的凭证（暂停取数）"/>
        <TextBlock Text="各云厂商的设置和凭证分别保存，切换后点击保存才生效。凭证按当前 Windows 用户加密保存；只读权限步骤见《使用说明》。" Foreground="#93A0B7" TextWrapping="Wrap" Margin="0,0,0,22"/>
        <TextBlock Text="颜色与磁盘" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="黄色起点（%）"/><TextBox x:Name="YellowBox" AutomationProperties.Name="黄色阈值"/></StackPanel>
          <StackPanel Grid.Column="2"><TextBlock Text="红色起点（%）"/><TextBox x:Name="RedBox" AutomationProperties.Name="红色阈值"/></StackPanel>
        </Grid>
        <TextBlock x:Name="DiskLabel" Text="固定磁盘设备（留空显示使用率最高的磁盘）"/><TextBox x:Name="DiskBox" AutomationProperties.Name="磁盘设备"/>
        <CheckBox x:Name="LockBox" Content="锁定颜色条位置"/>
        <CheckBox x:Name="StartupBox" Content="开机自动启动（当前 Windows 用户）"/>
        <TextBlock Text="开启后登录 Windows 自动显示。请将软件保留在固定目录，取消勾选并保存即可关闭。" Foreground="#93A0B7" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="从左到右：CPU · 内存 · 云盘 · 出站网络。每分钟刷新；悬停查看口径及采样周期，灰色表示尚无有效数据。" Foreground="#93A0B7" TextWrapping="Wrap"/>
        <TextBlock x:Name="ConfigPathText" Foreground="#74829B" FontSize="10" TextWrapping="Wrap" Margin="0,15,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
